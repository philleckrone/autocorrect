<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Archivo</sys:String>
    <sys:String x:Key="Menu_New">_Nuevo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Guardar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Guardar _como…</sys:String>
    <sys:String x:Key="Menu_Exit">_Salir</sys:String>
    <sys:String x:Key="Menu_Edit">_Editar</sys:String>
    <sys:String x:Key="Menu_AddEntry">_Agregar entrada</sys:String>
    <sys:String x:Key="Menu_DeleteEntry">_Eliminar entrada</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Font">Fuente:</sys:String>
    <sys:String x:Key="Toolbar_Size">Tamaño:</sys:String>
    <sys:String x:Key="Toolbar_Preview">Vista previa:</sys:String>
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>

    <!-- Banner -->
    <sys:String x:Key="Banner_RestartReminder">Recuerde reiniciar Paratext después de guardar los cambios.</sys:String>

    <!-- DataGrid columns -->
    <sys:String x:Key="Column_TypeKeys">Teclas</sys:String>
    <sys:String x:Key="Column_OutputCharacter">Carácter</sys:String>
    <sys:String x:Key="Column_UnicodeValues">Valor Unicode</sys:String>

    <!-- Add Entry bar -->
    <sys:String x:Key="AddBar_TypeSequence">Secuencia:</sys:String>
    <sys:String x:Key="AddBar_OutputChar">Carácter de salida:</sys:String>
    <sys:String x:Key="AddBar_OutputTooltip">Haga clic en un carácter del navegador para insertarlo aquí</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Add">Agregar</sys:String>
    <sys:String x:Key="Btn_Clear">Limpiar</sys:String>
    <sys:String x:Key="Btn_Update">Actualizar</sys:String>

    <!-- Character Browser -->
    <sys:String x:Key="Browser_Title">Explorador de caracteres</sys:String>
    <sys:String x:Key="Browser_Block">Bloque:</sys:String>
    <sys:String x:Key="Browser_Search">Buscar:</sys:String>
    <sys:String x:Key="Browser_SearchTooltip">Buscar en todos los bloques por carácter o código (ej. 00E0)</sys:String>
    <sys:String x:Key="Browser_BrowseBlock">Ver bloque</sys:String>
    <sys:String x:Key="Browser_Hide">Ocultar</sys:String>
    <sys:String x:Key="Browser_Show">Mostrar</sys:String>
    <sys:String x:Key="Browser_CharsFormat">{0} car.</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Unsaved">(sin guardar)</sys:String>
    <sys:String x:Key="Status_EntriesFormat">{0} entradas</sys:String>
    <sys:String x:Key="App_Title">Editor de Autocorrección</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Error al guardar</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">No se pudo guardar el archivo:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Cambios sin guardar</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Hay cambios sin guardar. ¿Guardar antes de continuar?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Abrir archivo de autocorrección</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Guardar archivo de autocorrección</sys:String>

</ResourceDictionary>
