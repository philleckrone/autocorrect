<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_File</sys:String>
    <sys:String x:Key="Menu_New">_New</sys:String>
    <sys:String x:Key="Menu_Open">_Open…</sys:String>
    <sys:String x:Key="Menu_Save">_Save</sys:String>
    <sys:String x:Key="Menu_SaveAs">Save _As…</sys:String>
    <sys:String x:Key="Menu_Exit">E_xit</sys:String>
    <sys:String x:Key="Menu_Edit">_Edit</sys:String>
    <sys:String x:Key="Menu_AddEntry">_Add Entry</sys:String>
    <sys:String x:Key="Menu_DeleteEntry">_Delete Entry</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Font">Font:</sys:String>
    <sys:String x:Key="Toolbar_Size">Size:</sys:String>
    <sys:String x:Key="Toolbar_Preview">Preview:</sys:String>
    <sys:String x:Key="Toolbar_Language">Language:</sys:String>

    <!-- Banner -->
    <sys:String x:Key="Banner_RestartReminder">Remember to restart Paratext after saving changes.</sys:String>

    <!-- DataGrid columns (used from code-behind) -->
    <sys:String x:Key="Column_TypeKeys">Type Keys</sys:String>
    <sys:String x:Key="Column_OutputCharacter">Output Character</sys:String>
    <sys:String x:Key="Column_UnicodeValues">Unicode Value(s)</sys:String>

    <!-- Add Entry bar -->
    <sys:String x:Key="AddBar_TypeSequence">Type sequence:</sys:String>
    <sys:String x:Key="AddBar_OutputChar">Output character:</sys:String>
    <sys:String x:Key="AddBar_OutputTooltip">Click a character in the browser below to insert it here</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Add">Add</sys:String>
    <sys:String x:Key="Btn_Clear">Clear</sys:String>
    <sys:String x:Key="Btn_Update">Update</sys:String>

    <!-- Character Browser -->
    <sys:String x:Key="Browser_Title">Character Browser</sys:String>
    <sys:String x:Key="Browser_Block">Block:</sys:String>
    <sys:String x:Key="Browser_Search">Search:</sys:String>
    <sys:String x:Key="Browser_SearchTooltip">Search all blocks by character or code point (e.g. 00E0)</sys:String>
    <sys:String x:Key="Browser_BrowseBlock">Browse block</sys:String>
    <sys:String x:Key="Browser_Hide">Hide</sys:String>
    <sys:String x:Key="Browser_Show">Show</sys:String>
    <sys:String x:Key="Browser_CharsFormat">{0} chars</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Unsaved">(unsaved)</sys:String>
    <sys:String x:Key="Status_EntriesFormat">{0} entries</sys:String>
    <sys:String x:Key="App_Title">AutoCorrect Editor</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Save Error</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Could not save file:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Unsaved Changes</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">There are unsaved changes. Save before continuing?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Open AutoCorrect File</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Save AutoCorrect File</sys:String>

</ResourceDictionary>
