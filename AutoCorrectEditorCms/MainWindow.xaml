<Window x:Class="AutoCorrectEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:AutoCorrectEditor"
        xmlns:controls="clr-namespace:AutoCorrectEditor.Controls"
        Title="AutoCorrect Editor"
        Height="720" Width="920"
        MinHeight="420" MinWidth="620"
        Closing="Window_Closing">

    <Window.Resources>
        <FontFamily x:Key="OutputFont">Charis SIL</FontFamily>
        <sys:Double x:Key="OutputFontSize">18</sys:Double>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New"
                        Executed="New_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}"
                        Executed="SaveAs_Executed"
                        CanExecute="Always_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Menu_New}"    Command="ApplicationCommands.New"/>
                <MenuItem Header="{DynamicResource Menu_Open}"   Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Save}"   Command="ApplicationCommands.Save"/>
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_Edit}">
                <MenuItem Header="{DynamicResource Menu_AddEntry}"    InputGestureText="Ins" Click="AddEntry_Click"/>
                <MenuItem Header="{DynamicResource Menu_DeleteEntry}" InputGestureText="Del" Click="DeleteEntry_Click"/>
            </MenuItem>
        </Menu>

        <!-- Font/size/language toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#F5F5F5"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Toolbar_Font}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="FontCombo"
                          Width="200"
                          Margin="0,0,14,0"
                          SelectionChanged="FontCombo_SelectionChanged"/>
                <TextBlock Text="{DynamicResource Toolbar_Size}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="FontSizeCombo"
                          Width="64"
                          Margin="0,0,14,0"
                          SelectionChanged="FontSizeCombo_SelectionChanged"/>
                <TextBlock Text="{DynamicResource Toolbar_Preview}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Foreground="Gray"/>
                <TextBlock x:Name="FontPreview"
                           Text="A à ý ç ñ ά"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontSize="{DynamicResource OutputFontSize}"
                           FontFamily="{DynamicResource OutputFont}"/>
                <TextBlock Text="{DynamicResource Toolbar_Language}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="LanguageCombo"
                          Width="130"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
            </WrapPanel>
        </Border>

        <!-- Restart reminder banner -->
        <Border DockPanel.Dock="Top"
                Background="#FFF3CD"
                BorderBrush="#FFEAA0"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <TextBlock Text="{DynamicResource Banner_RestartReminder}"
                       FontStyle="Italic"
                       Foreground="#856404"/>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="BrowserRow" Height="210" MinHeight="44"/>
            </Grid.RowDefinitions>

            <!-- Top area: DataGrid + Add Entry bar -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          x:Name="EntriesGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F8F8"
                          BorderThickness="0"
                          Margin="4,4,4,0"
                          PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                          BeginningEdit="EntriesGrid_BeginningEdit"
                          CellEditEnding="EntriesGrid_CellEditEnding"
                          SelectionChanged="EntriesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type Keys"
                                            Binding="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}"
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontSize"   Value="{DynamicResource OutputFontSize}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontSize"   Value="{DynamicResource OutputFontSize}"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Output Character"
                                            Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="{DynamicResource OutputFontSize}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource OutputFont}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontSize"   Value="{DynamicResource OutputFontSize}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource OutputFont}"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Unicode Value(s)"
                                            Binding="{Binding UnicodeValues}"
                                            IsReadOnly="True"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Add Entry bar -->
                <Border Grid.Row="1"
                        Background="#EFEFEF"
                        BorderBrush="#D0D0D0"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AddBar_TypeSequence}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="PatternBox"
                                 Width="110"
                                 Margin="0,0,14,0"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="{DynamicResource OutputFontSize}"
                                 VerticalContentAlignment="Center"
                                 GotFocus="InputBox_GotFocus"
                                 KeyDown="InputBox_KeyDown"/>
                        <TextBlock Text="{DynamicResource AddBar_OutputChar}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="OutputBox"
                                 Width="110"
                                 Margin="0,0,8,0"
                                 FontFamily="{DynamicResource OutputFont}"
                                 FontSize="{DynamicResource OutputFontSize}"
                                 VerticalContentAlignment="Center"
                                 GotFocus="InputBox_GotFocus"
                                 KeyDown="InputBox_KeyDown"
                                 ToolTip="{DynamicResource AddBar_OutputTooltip}"/>
                        <Button x:Name="AddBtn"
                                Content="{DynamicResource Btn_Add}"
                                Width="80"
                                Margin="0,0,6,0"
                                Padding="0,3"
                                Click="AddEntry_Click"/>
                        <Button Content="{DynamicResource Btn_Clear}"
                                Width="64"
                                Padding="0,3"
                                Click="ClearEntry_Click"/>
                    </WrapPanel>
                </Border>
            </Grid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#BBBBBB"
                          ShowsPreview="True"/>

            <!-- Character Browser -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Browser header with toggle -->
                <Border Grid.Row="0"
                        Background="#E8E8E8"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,0,1"
                        Padding="8,3">
                    <DockPanel>
                        <Button x:Name="ToggleBrowserBtn"
                                DockPanel.Dock="Right"
                                Width="60"
                                Padding="0,1"
                                Click="ToggleBrowser_Click"/>
                        <TextBlock Text="{DynamicResource Browser_Title}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Browser content -->
                <controls:CharacterBrowserControl Grid.Row="1"
                                                   x:Name="CharBrowser"
                                                   DisplayFont="{DynamicResource OutputFont}"
                                                   DisplayFontSize="{DynamicResource OutputFontSize}"
                                                   CharacterSelected="CharBrowser_CharacterSelected"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
