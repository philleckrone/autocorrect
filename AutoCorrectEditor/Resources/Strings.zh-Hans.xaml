<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">文件(_F)</sys:String>
    <sys:String x:Key="Menu_New">新建(_N)</sys:String>
    <sys:String x:Key="Menu_Open">打开(_O)…</sys:String>
    <sys:String x:Key="Menu_Save">保存(_S)</sys:String>
    <sys:String x:Key="Menu_SaveAs">另存为(_A)…</sys:String>
    <sys:String x:Key="Menu_Exit">退出(_X)</sys:String>
    <sys:String x:Key="Menu_Edit">编辑(_E)</sys:String>
    <sys:String x:Key="Menu_AddEntry">添加条目(_A)</sys:String>
    <sys:String x:Key="Menu_DeleteEntry">删除条目(_D)</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Font">字体：</sys:String>
    <sys:String x:Key="Toolbar_Size">大小：</sys:String>
    <sys:String x:Key="Toolbar_Preview">预览：</sys:String>
    <sys:String x:Key="Toolbar_Language">语言：</sys:String>

    <!-- Banner -->
    <sys:String x:Key="Banner_RestartReminder">保存更改后请记得重启 Paratext。</sys:String>

    <!-- DataGrid columns -->
    <sys:String x:Key="Column_TypeKeys">按键</sys:String>
    <sys:String x:Key="Column_OutputCharacter">输出字符</sys:String>
    <sys:String x:Key="Column_UnicodeValues">Unicode 值</sys:String>

    <!-- Add Entry bar -->
    <sys:String x:Key="AddBar_TypeSequence">键入序列：</sys:String>
    <sys:String x:Key="AddBar_OutputChar">输出字符：</sys:String>
    <sys:String x:Key="AddBar_OutputTooltip">点击下方字符浏览器中的字符以插入此处</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Add">添加</sys:String>
    <sys:String x:Key="Btn_Clear">清除</sys:String>
    <sys:String x:Key="Btn_Update">更新</sys:String>

    <!-- Character Browser -->
    <sys:String x:Key="Browser_Title">字符浏览器</sys:String>
    <sys:String x:Key="Browser_Block">块：</sys:String>
    <sys:String x:Key="Browser_Search">搜索：</sys:String>
    <sys:String x:Key="Browser_SearchTooltip">在所有块中按字符或码点搜索（如 00E0）</sys:String>
    <sys:String x:Key="Browser_BrowseBlock">浏览块</sys:String>
    <sys:String x:Key="Browser_Hide">隐藏</sys:String>
    <sys:String x:Key="Browser_Show">显示</sys:String>
    <sys:String x:Key="Browser_CharsFormat">{0} 个字符</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Unsaved">（未保存）</sys:String>
    <sys:String x:Key="Status_EntriesFormat">{0} 个条目</sys:String>
    <sys:String x:Key="App_Title">自动更正编辑器</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">保存错误</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">无法保存文件：</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">未保存的更改</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">存在未保存的更改。是否在继续之前保存？</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">打开自动更正文件</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">保存自动更正文件</sys:String>

</ResourceDictionary>
