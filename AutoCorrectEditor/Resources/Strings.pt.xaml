<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Arquivo</sys:String>
    <sys:String x:Key="Menu_New">_Novo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Salvar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Salvar _como…</sys:String>
    <sys:String x:Key="Menu_Exit">_Sair</sys:String>
    <sys:String x:Key="Menu_Edit">_Editar</sys:String>
    <sys:String x:Key="Menu_AddEntry">_Adicionar entrada</sys:String>
    <sys:String x:Key="Menu_DeleteEntry">_Excluir entrada</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Font">Fonte:</sys:String>
    <sys:String x:Key="Toolbar_Size">Tamanho:</sys:String>
    <sys:String x:Key="Toolbar_Preview">Visualização:</sys:String>
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>

    <!-- Banner -->
    <sys:String x:Key="Banner_RestartReminder">Lembre-se de reiniciar o Paratext após salvar as alterações.</sys:String>

    <!-- DataGrid columns -->
    <sys:String x:Key="Column_TypeKeys">Teclas</sys:String>
    <sys:String x:Key="Column_OutputCharacter">Caractere</sys:String>
    <sys:String x:Key="Column_UnicodeValues">Valor Unicode</sys:String>

    <!-- Add Entry bar -->
    <sys:String x:Key="AddBar_TypeSequence">Sequência:</sys:String>
    <sys:String x:Key="AddBar_OutputChar">Caractere de saída:</sys:String>
    <sys:String x:Key="AddBar_OutputTooltip">Clique em um caractere no navegador abaixo para inseri-lo aqui</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Add">Adicionar</sys:String>
    <sys:String x:Key="Btn_Clear">Limpar</sys:String>
    <sys:String x:Key="Btn_Update">Atualizar</sys:String>

    <!-- Character Browser -->
    <sys:String x:Key="Browser_Title">Navegador de caracteres</sys:String>
    <sys:String x:Key="Browser_Block">Bloco:</sys:String>
    <sys:String x:Key="Browser_Search">Pesquisar:</sys:String>
    <sys:String x:Key="Browser_SearchTooltip">Pesquisar em todos os blocos por caractere ou código (ex. 00E0)</sys:String>
    <sys:String x:Key="Browser_BrowseBlock">Ver bloco</sys:String>
    <sys:String x:Key="Browser_Hide">Ocultar</sys:String>
    <sys:String x:Key="Browser_Show">Mostrar</sys:String>
    <sys:String x:Key="Browser_CharsFormat">{0} car.</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Unsaved">(não salvo)</sys:String>
    <sys:String x:Key="Status_EntriesFormat">{0} entradas</sys:String>
    <sys:String x:Key="App_Title">Editor de Autocorreção</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Erro ao salvar</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Não foi possível salvar o arquivo:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Alterações não salvas</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Há alterações não salvas. Salvar antes de continuar?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Abrir arquivo de autocorreção</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Salvar arquivo de autocorreção</sys:String>

</ResourceDictionary>
