<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Fichier</sys:String>
    <sys:String x:Key="Menu_New">_Nouveau</sys:String>
    <sys:String x:Key="Menu_Open">_Ouvrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Enregistrer</sys:String>
    <sys:String x:Key="Menu_SaveAs">Enregistrer _sous…</sys:String>
    <sys:String x:Key="Menu_Exit">_Quitter</sys:String>
    <sys:String x:Key="Menu_Edit">É_diter</sys:String>
    <sys:String x:Key="Menu_AddEntry">_Ajouter une entrée</sys:String>
    <sys:String x:Key="Menu_DeleteEntry">_Supprimer une entrée</sys:String>

    <!-- Toolbar -->
    <sys:String x:Key="Toolbar_Font">Police :</sys:String>
    <sys:String x:Key="Toolbar_Size">Taille :</sys:String>
    <sys:String x:Key="Toolbar_Preview">Aperçu :</sys:String>
    <sys:String x:Key="Toolbar_Language">Langue :</sys:String>

    <!-- Banner -->
    <sys:String x:Key="Banner_RestartReminder">N'oubliez pas de redémarrer Paratext après avoir enregistré les modifications.</sys:String>

    <!-- DataGrid columns -->
    <sys:String x:Key="Column_TypeKeys">Touches</sys:String>
    <sys:String x:Key="Column_OutputCharacter">Caractère</sys:String>
    <sys:String x:Key="Column_UnicodeValues">Valeur Unicode</sys:String>

    <!-- Add Entry bar -->
    <sys:String x:Key="AddBar_TypeSequence">Séquence :</sys:String>
    <sys:String x:Key="AddBar_OutputChar">Caractère de sortie :</sys:String>
    <sys:String x:Key="AddBar_OutputTooltip">Cliquez sur un caractère dans le navigateur pour l'insérer ici</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_Add">Ajouter</sys:String>
    <sys:String x:Key="Btn_Clear">Effacer</sys:String>
    <sys:String x:Key="Btn_Update">Mettre à jour</sys:String>

    <!-- Character Browser -->
    <sys:String x:Key="Browser_Title">Navigateur de caractères</sys:String>
    <sys:String x:Key="Browser_Block">Bloc :</sys:String>
    <sys:String x:Key="Browser_Search">Rechercher :</sys:String>
    <sys:String x:Key="Browser_SearchTooltip">Rechercher dans tous les blocs par caractère ou point de code (ex. 00E0)</sys:String>
    <sys:String x:Key="Browser_BrowseBlock">Voir bloc</sys:String>
    <sys:String x:Key="Browser_Hide">Masquer</sys:String>
    <sys:String x:Key="Browser_Show">Afficher</sys:String>
    <sys:String x:Key="Browser_CharsFormat">{0} car.</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Unsaved">(non enregistré)</sys:String>
    <sys:String x:Key="Status_EntriesFormat">{0} entrées</sys:String>
    <sys:String x:Key="App_Title">Éditeur de correction automatique</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Erreur de sauvegarde</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Impossible d'enregistrer le fichier :</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Modifications non enregistrées</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Il y a des modifications non enregistrées. Enregistrer avant de continuer ?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Ouvrir un fichier de correction automatique</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Enregistrer le fichier de correction automatique</sys:String>

</ResourceDictionary>
